# Copy this file to .env and fill in the real values.
BOT_TOKEN=PASTE_YOUR_BOT_TOKEN_HERE
OWNER_ID=123456789
DATABASE_PATH=data/group_bot.db

# XP earned from eligible group messages
XP_PER_MESSAGE=10
XP_COOLDOWN_SECONDS=60

# Default level at which members may request admin status
ADMIN_LEVEL=70

# Public HTTPS URL of the Telegram Mini App (set after adding a Railway domain)
MINI_APP_URL=https://your-railway-domain.up.railway.app
